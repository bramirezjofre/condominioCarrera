{
  "name": "condominio-jmc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de administracion de condominio (Node.js + Supabase PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext js,ejs src/server.js",
    "start": "node src/server.js",
    "build": "npm run css:build",
    "css:build": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --watch",
    "db:migrate": "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down",
    "db:seed": "node scripts/seed.js",
    "db:check-ipv4": "node scripts/check-ipv4.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "argon2": "^0.41.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "htmx.org": "^1.9.12",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^0.1.2",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "node-pg-migrate": "^7.6.1",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.13",
    "vitest": "^2.1.2"
  }
}
