<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Configuracion del espacio', actions: [{ label: 'Volver', href: '/app/espacios-comunes', class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="#" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="name" class="label">Nombre</label>
          <input id="name" name="name" class="input" required />
        </div>
        <div>
          <label for="capacity" class="label">Capacidad</label>
          <input id="capacity" name="capacity" type="number" class="input" value="20" />
        </div>
        <div>
          <label for="price" class="label">Tarifa</label>
          <input id="price" name="price" type="number" class="input" />
        </div>
        <div>
          <label for="depositAmount" class="label">Deposito</label>
          <input id="depositAmount" name="depositAmount" type="number" class="input" />
        </div>
        <div class="flex items-center gap-2 md:col-span-2">
          <input id="requiresApproval" name="requiresApproval" type="checkbox" <%= item.requiresApproval ? 'checked' : '' %> />
          <label for="requiresApproval">Requiere aprobacion</label>
        </div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary">Guardar</button>
        <a href="/app/espacios-comunes" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>