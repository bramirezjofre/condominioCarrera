<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Edicion de torre', actions: [{ label: 'Volver', href: '/app/torres', class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="#" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="name" class="label">Nombre</label>
          <input id="name" name="name" class="input" value="<%= item.name %>" required />
        </div>
        <div>
          <label for="code" class="label">Codigo</label>
          <input id="code" name="code" class="input" value="<%= item.code %>" required />
        </div>
        <div>
          <label for="floorCount" class="label">Pisos</label>
          <input id="floorCount" name="floorCount" type="number" class="input" value="<%= item.floorCount %>" />
        </div>
        <div>
          <label for="addressDetail" class="label">Direccion</label>
          <input id="addressDetail" name="addressDetail" class="input" value="<%= item.addressDetail || '' %>" />
        </div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary">Guardar</button>
        <a href="/app/torres" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>