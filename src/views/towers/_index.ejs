<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Vista general de las torres del condominio', actions: [{ label: 'Nueva torre', href: '#', class: 'btn-primary' }] }) %>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin torres', description: 'Crea torres para empezar.' }) %>
  <% } else { %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% for (const t of items) { %>
        <a href="/app/torres/<%= t.id %>" class="card-tight hover:border-gold-500 transition block">
          <div class="flex items-start justify-between">
            <div>
              <h3 class="font-display text-lg text-navy-900"><%= t.name %></h3>
              <p class="text-sm text-muted"><%= t.code %> - <%= t.addressDetail || 'Sin direccion' %></p>
            </div>
            <span class="badge-gold"><%= t.unitCount %> unid.</span>
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-2 text-sm">
            <div>
              <dt class="text-muted">Administrador</dt>
              <dd class="font-medium"><%= t.adminName %></dd>
            </div>
            <div>
              <dt class="text-muted">Morosidad</dt>
              <dd class="font-medium"><%= t.delinquencyPercent %>%</dd>
            </div>
          </dl>
        </a>
      <% } %>
    </div>
  <% } %>
</div>