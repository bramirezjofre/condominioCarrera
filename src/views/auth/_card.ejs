<div class="w-full max-w-md bg-white shadow-lg rounded-lg p-8 border border-border">
  <h1 class="text-2xl font-bold text-navy-900 mb-1">Condominio JMC</h1>
  <p class="text-sm text-muted mb-6">Sistema de administracion</p>
  <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-3 py-2 rounded mb-4 text-sm">
      <%= error %>
    </div>
  <% } %>
  <form method="post" action="/login" class="space-y-4">
    <div>
      <label for="identifier" class="block text-sm font-medium mb-1">Email o usuario</label>
      <input
        id="identifier"
        name="identifier"
        type="text"
        required
        autocomplete="username"
        value="<%= identifier %>"
        class="w-full border border-border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500"
      />
    </div>
    <div>
      <label for="password" class="block text-sm font-medium mb-1">Contrasena</label>
      <input
        id="password"
        name="password"
        type="password"
        required
        autocomplete="current-password"
        class="w-full border border-border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500"
      />
    </div>
    <button type="submit" class="w-full bg-navy-900 hover:bg-navy-800 text-white font-medium px-4 py-2 rounded">
      Ingresar
    </button>
  </form>
</div>