<div class="text-center">
  <h1 class="font-display text-2xl text-navy-900 mb-2">Bienvenido al condominio</h1>
  <p class="text-sm text-muted">Ingrese sus credenciales para acceder al sistema.</p>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error mb-4" role="alert"><%= error %></div>
<% } %>

<form method="post" action="/login" class="space-y-4">
  <div>
    <label for="identifier" class="label">Correo o usuario</label>
    <input id="identifier" name="identifier" type="text" required autocomplete="username" value="<%= identifier %>" class="input" />
  </div>
  <div>
    <div class="flex items-center justify-between mb-1">
      <label for="password" class="label mb-0">Contrasena</label>
      <a href="/recuperar-acceso" class="text-xs text-gold-700 hover:underline">Olvide mi contrasena</a>
    </div>
    <input id="password" name="password" type="password" required autocomplete="current-password" class="input" />
  </div>
  <button type="submit" class="btn-primary w-full">Ingresar</button>
</form>

<details class="mt-4">
  <summary class="text-sm text-muted cursor-pointer hover:text-navy-900">Usuarios demo</summary>
  <ul class="text-xs text-muted mt-2 space-y-1">
    <li><code>admin</code></li>
    <li><code>torre1</code></li>
    <li><code>torre2</code></li>
    <li><code>contabilidad</code></li>
    <li><code>conserjeria</code></li>
    <li><code>comite</code></li>
    <li><code>residente101</code></li>
  </ul>
  <p class="text-xs text-muted mt-2">Contrasena: <code>demo123</code></p>
</details>