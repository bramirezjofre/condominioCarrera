<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Datos del pago', actions: [{ label: 'Volver', href: '/app/pagos', class: 'btn-secondary' }] }) %>

  <section class="card grid gap-4 md:grid-cols-2">
    <div><dt class="text-muted">Unidad</dt><dd class="font-medium"><%= unit ? unit.number : '-' %></dd></div>
    <div><dt class="text-muted">Pagador</dt><dd class="font-medium"><%= person ? person.fullName : '-' %></dd></div>
    <div><dt class="text-muted">Monto</dt><dd class="font-medium">$ <%= Math.round(item.amount / 1000) %>k</dd></div>
    <div><dt class="text-muted">Metodo</dt><dd class="font-medium"><%= item.paymentMethod %></dd></div>
    <div><dt class="text-muted">Fecha</dt><dd class="font-medium"><%= item.paidAt %></dd></div>
    <div><dt class="text-muted">Referencia</dt><dd class="font-medium"><%= item.reference %></dd></div>
    <div><dt class="text-muted">Estado</dt><dd class="font-medium"><%= item.status %></dd></div>
    <div><dt class="text-muted">Verificado por</dt><dd class="font-medium"><%= item.verifiedBy || '-' %></dd></div>
  </section>

  <% if (user.roleCodes?.includes('accountant') || user.isCondominiumAdmin) { %>
    <div class="card">
      <h2 class="font-display text-xl text-navy-900 mb-4">Acciones</h2>
      <div class="flex flex-wrap gap-2">
        <% if (item.status === 'pending_verification') { %>
          <form method="post" action="/app/pagos/<%= item.id %>/verificar" class="inline">
            <button type="submit" class="btn-primary" aria-label="Verificar pago">Verificar</button>
          </form>
          <form method="post" action="/app/pagos/<%= item.id %>/rechazar" class="inline">
            <button type="submit" class="btn-secondary" aria-label="Rechazar pago">Rechazar</button>
          </form>
        <% } %>
        <% if (item.status === 'verified') { %>
          <form method="post" action="/app/pagos/<%= item.id %>/reversar" class="inline">
            <label class="flex items-center gap-2">
              <input type="text" name="reason" placeholder="Motivo obligatorio" class="input" required />
            </label>
            <button type="submit" class="btn-danger" aria-label="Reversar pago">Reversar</button>
          </form>
        <% } %>
        <a href="/app/pagos" class="btn-ghost">Volver al listado</a>
      </div>
    </div>
  <% } %>
</div>
