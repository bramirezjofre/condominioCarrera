<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Crear un aviso', actions: [{ label: 'Volver', href: '/app/comunicados', class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="<%= formAction %>" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="title" class="label">Titulo</label>
          <input id="title" name="title" class="input" value="<%= item.title || '' %>" <%= errors.title ? 'aria-invalid="true"' : '' %> required />
          <% if (errors.title) { %><p class="text-xs text-danger mt-1"><%= errors.title %></p><% } %>
        </div>
        <div>
          <label for="priority" class="label">Prioridad</label>
          <select id="priority" name="priority" class="select">
            <% for (const p of ['low','normal','high','urgent']) { %>
              <option value="<%= p %>" <%= item.priority === p ? 'selected' : '' %>><%= p %></option>
            <% } %>
          </select>
        </div>
        <div class="md:col-span-2">
          <label for="body" class="label">Contenido</label>
          <textarea id="body" name="body" class="textarea" required><%= item.body || '' %></textarea>
        </div>
        <div>
          <label for="publishedAt" class="label">Publicacion</label>
          <input id="publishedAt" name="publishedAt" type="date" class="input" />
        </div>
        <div>
          <label for="expiresAt" class="label">Vencimiento</label>
          <input id="expiresAt" name="expiresAt" type="date" class="input" />
        </div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary" aria-label="Guardar comunicado">Guardar</button>
        <a href="<%= cancelHref %>" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>