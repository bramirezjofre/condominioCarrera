<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: item.title, subtitleText: 'Por ' + author, actions: [{ label: 'Volver', href: '/app/comunicados', class: 'btn-secondary' }] }) %>

  <article class="card prose max-w-none">
    <p class="text-sm text-muted"><%= item.publishedAt || 'Sin publicar' %></p>
    <h1 class="font-display text-2xl text-navy-900 mt-2 mb-4"><%= item.title %></h1>
    <p class="text-base"><%= item.body %></p>
  </article>

  <% if (canPublish) { %>
    <div class="card flex flex-wrap gap-2">
      <% if (item.status === 'draft') { %>
        <form method="post" action="/app/comunicados/<%= item.id %>/publicar" class="inline">
          <button type="submit" class="btn-primary" aria-label="Publicar comunicado">Publicar</button>
        </form>
        <form method="post" action="/app/comunicados/<%= item.id %>/programar" class="inline">
          <label class="flex items-center gap-2">
            <input type="datetime-local" name="scheduledAt" class="input" required />
          </label>
          <button type="submit" class="btn-secondary" aria-label="Programar comunicado">Programar</button>
        </form>
      <% } %>
      <% if (item.status !== 'archived') { %>
        <form method="post" action="/app/comunicados/<%= item.id %>/archivar" class="inline">
          <button type="submit" class="btn-danger" aria-label="Archivar comunicado">Archivar</button>
        </form>
      <% } %>
    </div>
  <% } %>
</div>
