<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Detalle de reserva', actions: [{ label: 'Volver', href: '/app/reservas', class: 'btn-secondary' }] }) %>

  <section class="card grid gap-4 md:grid-cols-2">
    <div><dt class="text-muted">Espacio</dt><dd class="font-medium"><%= amenity ? amenity.name : '-' %></dd></div>
    <div><dt class="text-muted">Unidad</dt><dd class="font-medium"><%= unit ? unit.number : '-' %></dd></div>
    <div><dt class="text-muted">Solicitante</dt><dd class="font-medium"><%= person ? person.fullName : '-' %></dd></div>
    <div><dt class="text-muted">Asistentes</dt><dd class="font-medium"><%= item.attendeeCount %></dd></div>
    <div><dt class="text-muted">Inicio</dt><dd class="font-medium"><%= item.startsAt %></dd></div>
    <div><dt class="text-muted">Fin</dt><dd class="font-medium"><%= item.endsAt %></dd></div>
    <div><dt class="text-muted">Estado</dt><dd class="font-medium"><%= item.status %></dd></div>
    <div><dt class="text-muted">Motivo rechazo</dt><dd class="font-medium"><%= item.rejectionReason || '-' %></dd></div>
  </section>

  <div class="card flex flex-wrap gap-2">
    <% if (canManage) { %>
      <% if (item.status === 'requested') { %>
        <form method="post" action="/app/reservas/<%= item.id %>/aprobar" class="inline">
          <button type="submit" class="btn-primary" aria-label="Aprobar reserva">Aprobar</button>
        </form>
        <form method="post" action="/app/reservas/<%= item.id %>/rechazar" class="inline">
          <label class="flex items-center gap-2">
            <input type="text" name="reason" placeholder="Motivo obligatorio" class="input" required />
          </label>
          <button type="submit" class="btn-danger" aria-label="Rechazar reserva">Rechazar</button>
        </form>
      <% } %>
    <% } %>
    <% if (item.status === 'approved' || item.status === 'requested') { %>
      <form method="post" action="/app/reservas/<%= item.id %>/cancelar" class="inline">
        <label class="flex items-center gap-2">
          <input type="text" name="reason" placeholder="Motivo obligatorio" class="input" required />
        </label>
        <button type="submit" class="btn-secondary" aria-label="Cancelar reserva">Cancelar</button>
      </form>
    <% } %>
  </div>
</div>
