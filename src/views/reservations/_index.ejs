<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Reservas de espacios comunes', actions: [{ label: 'Nueva reserva', href: '/app/reservas/nueva', class: 'btn-primary' }] }) %>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin reservas', description: 'Crea la primera reserva.' }) %>
  <% } else { %>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Espacio</th>
            <th>Unidad</th>
            <th>Solicitante</th>
            <th>Asistentes</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% for (const r of items) { %>
            <tr>
              <td><%= r.startsAt %></td>
              <td><%= r.amenity ? r.amenity.name : '-' %></td>
              <td><%= r.unit ? r.unit.number : '-' %></td>
              <td><%= r.person ? r.person.fullName : '-' %></td>
              <td><%= r.attendeeCount %></td>
              <td>
                <% if (r.status === 'approved') { %>
                  <span class="badge-success">Aprobada</span>
                <% } else if (r.status === 'rejected') { %>
                  <span class="badge-danger">Rechazada</span>
                <% } else if (r.status === 'cancelled') { %>
                  <span class="badge-muted">Cancelada</span>
                <% } else if (r.status === 'completed') { %>
                  <span class="badge-success">Completada</span>
                <% } else { %>
                  <span class="badge-warning">Solicitada</span>
                <% } %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>