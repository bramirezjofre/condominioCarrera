<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Datos de la persona', actions: [{ label: 'Editar', href: '/app/personas/' + person.id + '/editar', class: 'btn-secondary' }] }) %>

  <section class="card grid gap-4 md:grid-cols-2">
    <div><dt class="text-muted">RUN / RUT</dt><dd class="font-medium"><%= person.nationalId || '-' %></dd></div>
    <div><dt class="text-muted">Email</dt><dd class="font-medium"><%= person.email || '-' %></dd></div>
    <div><dt class="text-muted">Telefono</dt><dd class="font-medium"><%= person.phone || '-' %></dd></div>
    <div><dt class="text-muted">Fecha de nacimiento</dt><dd class="font-medium"><%= person.birthDate || '-' %></dd></div>
  </section>

  <section class="card">
    <h2 class="font-display text-xl text-navy-900 mb-4">Ocupaciones</h2>
    <% if (occupancies.length === 0) { %>
      <%- include('../partials/empty-state', { title: 'Sin ocupaciones', description: 'Asigna esta persona a una unidad para comenzar.' }) %>
    <% } else { %>
      <ul class="divide-y divide-border">
        <% for (const o of occupancies) { %>
          <li class="py-3 flex items-center justify-between">
            <div>
              <p class="font-medium"><%= o.unit ? o.unit.number : 'Sin unidad' %></p>
              <p class="text-xs text-muted"><%= o.tower ? o.tower.name : '' %> - <%= o.occupancyType %></p>
            </div>
            <span class="<%= o.endsOn ? 'badge-muted' : 'badge-success' %>"><%= o.endsOn ? 'Finalizada' : 'Vigente' %></span>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <h2 class="font-display text-xl text-navy-900 mb-4">Acceso al sistema</h2>
    <% if (user) { %>
      <p class="text-sm">Usuario: <strong><%= user.username %></strong> - <%= user.email %></p>
      <p class="text-xs text-muted mt-1">Estado: <%= user.status %></p>
    <% } else { %>
      <p class="text-sm text-muted">Esta persona aun no tiene cuenta de usuario.</p>
    <% } %>
  </section>
</div>