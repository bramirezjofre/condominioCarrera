<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Listado de personas del condominio', actions: [{ label: 'Nueva persona', href: '/app/personas/nuevo', class: 'btn-primary' }] }) %>

  <form method="get" action="/app/personas" class="card-tight flex gap-2">
    <input class="input flex-1" type="search" name="search" value="<%= search %>" placeholder="Buscar por nombre o email" aria-label="Buscar" />
    <button type="submit" class="btn-primary">Buscar</button>
  </form>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin personas', description: 'Agrega la primera persona del condominio.' }) %>
  <% } else { %>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Email</th>
            <th>Telefono</th>
            <th>Unidades</th>
            <th></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% for (const p of items) { %>
            <tr>
              <td>
                <a href="/app/personas/<%= p.id %>" class="font-medium text-navy-900 hover:underline"><%= p.fullName %></a>
              </td>
              <td><%= p.email || '-' %></td>
              <td><%= p.phone || '-' %></td>
              <td>
                <% if (p.units.length === 0) { %>
                  <span class="badge-muted">Sin unidad</span>
                <% } else { %>
                  <% for (const u of p.units) { %>
                    <span class="badge-navy"><%= u.number %></span>
                  <% } %>
                <% } %>
              </td>
              <td class="text-right">
                <a href="/app/personas/<%= p.id %>/editar" class="text-sm text-navy-900 hover:underline">Editar</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>