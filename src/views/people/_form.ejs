<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Datos personales', actions: [{ label: 'Volver', href: '/app/personas', class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="#" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="firstName" class="label">Nombre</label>
          <input id="firstName" name="firstName" class="input" value="<%= item.firstName %>" required />
        </div>
        <div>
          <label for="lastName" class="label">Apellido</label>
          <input id="lastName" name="lastName" class="input" value="<%= item.lastName %>" required />
        </div>
        <div>
          <label for="nationalId" class="label">RUN / RUT</label>
          <input id="nationalId" name="nationalId" class="input" value="<%= item.nationalId || '' %>" />
        </div>
        <div>
          <label for="email" class="label">Email</label>
          <input id="email" name="email" type="email" class="input" value="<%= item.email || '' %>" />
        </div>
        <div>
          <label for="phone" class="label">Telefono</label>
          <input id="phone" name="phone" class="input" value="<%= item.phone || '' %>" />
        </div>
        <div>
          <label for="birthDate" class="label">Fecha de nacimiento</label>
          <input id="birthDate" name="birthDate" type="date" class="input" value="<%= item.birthDate || '' %>" />
        </div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary">Guardar</button>
        <a href="/app/personas" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>