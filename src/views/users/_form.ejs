<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Datos del usuario', actions: [{ label: 'Volver', href: '/app/usuarios', class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="<%= formAction %>" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="personId" class="label">Persona</label>
          <select id="personId" name="personId" class="select">
            <option value="">Seleccionar...</option>
            <% for (const p of people) { %>
              <option value="<%= p.id %>" <%= item.personId === p.id ? 'selected' : '' %>><%= p.fullName %></option>
            <% } %>
          </select>
          <% if (errors.personId) { %><p class="text-xs text-danger mt-1"><%= errors.personId %></p><% } %>
        </div>
        <div>
          <label for="username" class="label">Usuario</label>
          <input id="username" name="username" class="input" value="<%= item.username %>" <%= errors.username ? 'aria-invalid="true"' : '' %> required />
          <% if (errors.username) { %><p class="text-xs text-danger mt-1"><%= errors.username %></p><% } %>
        </div>
        <div>
          <label for="email" class="label">Email</label>
          <input id="email" name="email" type="email" class="input" value="<%= item.email %>" <%= errors.email ? 'aria-invalid="true"' : '' %> required />
          <% if (errors.email) { %><p class="text-xs text-danger mt-1"><%= errors.email %></p><% } %>
        </div>
        <div>
          <label for="status" class="label">Estado</label>
          <select id="status" name="status" class="select">
            <% for (const s of ['active','blocked','disabled']) { %>
              <option value="<%= s %>" <%= item.status === s ? 'selected' : '' %>><%= s %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="role" class="label">Rol primario</label>
          <select id="role" name="role" class="select">
            <% for (const r of roles) { %>
              <option value="<%= r %>" <%= item.role === r ? 'selected' : '' %>><%= r %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="tower" class="label">Torre</label>
          <select id="tower" name="tower" class="select">
            <option value="">Sin asignar</option>
            <% for (const t of towers) { %>
              <option value="<%= t.id %>" <%= item.towerId === t.id ? 'selected' : '' %>><%= t.name %></option>
            <% } %>
          </select>
        </div>
      </div>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="mustChangePassword" <%= item.mustChangePassword ? 'checked' : '' %> /> Debe cambiar contrasena
      </label>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary" aria-label="Guardar usuario">Guardar</button>
        <a href="<%= cancelHref %>" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>