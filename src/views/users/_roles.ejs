<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Roles y permisos del sistema', actions: [{ label: 'Permisos', href: '#', class: 'btn-secondary' }] }) %>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% for (const r of items) { %>
      <div class="card">
        <h3 class="font-display text-lg text-navy-900"><%= r.label %></h3>
        <p class="text-xs text-muted">Codigo: <%= r.code %></p>
        <ul class="mt-3 space-y-1 text-xs">
          <% for (const p of r.permissions) { %>
            <li class="text-muted"><%= p %></li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </div>
</div>