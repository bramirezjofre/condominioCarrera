<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: item.username, subtitleText: item.email, actions: [{ label: 'Editar', href: '/app/usuarios/' + item.id + '/editar', class: 'btn-secondary' }, { label: 'Asignaciones', href: '/app/usuarios/' + item.id + '/asignaciones', class: 'btn-primary' }] }) %>

  <section class="card grid gap-4 md:grid-cols-2">
    <div><dt class="text-muted">Persona</dt><dd class="font-medium"><%= person ? person.fullName : '-' %></dd></div>
    <div><dt class="text-muted">Estado</dt><dd class="font-medium"><%= item.status %></dd></div>
    <div><dt class="text-muted">Roles</dt><dd class="font-medium"><%= item.roleCodes?.join(', ') %></dd></div>
    <div><dt class="text-muted">Torres</dt><dd class="font-medium"><%= towers.map(t => t.name).join(', ') || '-' %></dd></div>
  </section>
</div>