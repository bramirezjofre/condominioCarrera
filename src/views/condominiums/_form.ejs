<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Edicion de datos institucionales', actions: [{ label: 'Volver', href: '/app/condominios', class: 'btn-secondary' }] }) %>
  <div class="card">
    <form method="post" action="#" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="name" class="label">Nombre</label>
          <input id="name" name="name" class="input" value="<%= item.name %>" required />
        </div>
        <div>
          <label for="legalName" class="label">Razon social</label>
          <input id="legalName" name="legalName" class="input" value="<%= item.legalName %>" />
        </div>
        <div>
          <label for="taxId" class="label">RUT</label>
          <input id="taxId" name="taxId" class="input" value="<%= item.taxId %>" />
        </div>
        <div>
          <label for="currency" class="label">Moneda</label>
          <input id="currency" name="currency" class="input" value="<%= item.currency %>" />
        </div>
        <div class="md:col-span-2">
          <label for="address" class="label">Direccion</label>
          <input id="address" name="address" class="input" value="<%= item.address %>" />
        </div>
        <div>
          <label for="commune" class="label">Comuna</label>
          <input id="commune" name="commune" class="input" value="<%= item.commune %>" />
        </div>
        <div>
          <label for="region" class="label">Region</label>
          <input id="region" name="region" class="input" value="<%= item.region %>" />
        </div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary">Guardar</button>
        <a href="/app/condominios" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>