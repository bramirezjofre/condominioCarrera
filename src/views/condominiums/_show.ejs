<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Vista del condominio', actions: [{ label: 'Editar', href: '/app/condominios/' + item.id + '/editar', class: 'btn-secondary' }, { label: 'Configuracion', href: '/app/configuracion', class: 'btn-gold' }] }) %>

  <section class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <%- include('../partials/stat-card', { label: 'Torres', value: towers.length }) %>
    <%- include('../partials/stat-card', { label: 'Unidades', value: towers.reduce((s, t) => s + (t.unitCount || 0), 0) }) %>
    <%- include('../partials/stat-card', { label: 'Comuna', value: item.commune }) %>
    <%- include('../partials/stat-card', { label: 'Zona horaria', value: item.timezone }) %>
  </section>

  <section class="card">
    <h2 class="font-display text-xl text-navy-900 mb-4">Datos del condominio</h2>
    <dl class="grid gap-4 md:grid-cols-2 text-sm">
      <div><dt class="text-muted">Nombre legal</dt><dd class="font-medium"><%= item.legalName %></dd></div>
      <div><dt class="text-muted">RUT</dt><dd class="font-medium"><%= item.taxId %></dd></div>
      <div><dt class="text-muted">Direccion</dt><dd class="font-medium"><%= item.address %></dd></div>
      <div><dt class="text-muted">Region</dt><dd class="font-medium"><%= item.region %></dd></div>
      <div><dt class="text-muted">Moneda</dt><dd class="font-medium"><%= item.currency %></dd></div>
      <div><dt class="text-muted">Estado</dt><dd class="font-medium"><%= item.active ? 'Activo' : 'Inactivo' %></dd></div>
    </dl>
  </section>

  <section class="card">
    <header class="flex items-center justify-between mb-4">
      <h2 class="font-display text-xl text-navy-900">Torres</h2>
      <a href="/app/torres" class="text-sm text-navy-900 hover:underline">Ver todas</a>
    </header>
    <% if (towers.length === 0) { %>
      <%- include('../partials/empty-state', { title: 'Sin torres', description: 'Agrega torres para empezar.' }) %>
    <% } else { %>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% for (const t of towers) { %>
          <a href="/app/torres/<%= t.id %>" class="card-tight hover:border-gold-500 transition block">
            <h3 class="font-display text-lg text-navy-900"><%= t.name %></h3>
            <p class="text-sm text-muted"><%= t.code %></p>
          </a>
        <% } %>
      </div>
    <% } %>
  </section>
</div>