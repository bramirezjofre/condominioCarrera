<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Pagos por periodo', actions: [{ label: 'Exportar CSV', href: '#', class: 'btn-secondary' }] }) %>

  <div class="card">
    <div class="h-64 flex items-end gap-3" role="img" aria-label="Grafico de recaudacion">
      <% for (let i = 0; i < 6; i++) { %>
        <div class="flex-1 flex flex-col items-center gap-1">
          <span class="text-xs text-muted">$ <%= 1000 + (i * 250) %>k</span>
          <div class="w-full bg-gold-pattern rounded-t-md" style="height: <%= 40 + (i * 10) %>%"></div>
          <span class="text-xs text-muted">M<%= i + 1 %></span>
        </div>
      <% } %>
    </div>
  </div>
</div>