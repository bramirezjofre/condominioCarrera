<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Pagos por periodo', actions: [{ label: 'Exportar CSV', href: '/app/reportes/recaudacion/csv', class: 'btn-secondary' }] }) %>

  <% const reportItems = locals.items || []; %>
  <% if (reportItems.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin datos', description: 'Aun no hay periodos emitidos para mostrar.' }) %>
  <% } else { %>
    <% const maxPaid = reportItems.reduce((m, r) => Math.max(m, r.paid), 0); %>
    <div class="card">
      <div class="h-64 flex items-end gap-3" role="img" aria-label="Grafico de recaudacion">
        <% for (const r of reportItems) { %>
          <% const height = maxPaid === 0 ? 0 : Math.max(4, Math.round((r.paid / maxPaid) * 100)); %>
          <div class="flex-1 flex flex-col items-center gap-1">
            <span class="text-xs text-muted">$ <%= Math.round(r.paid / 1000) %>k</span>
            <div class="w-full bg-gold-pattern rounded-t-md" style="height: <%= height %>%"></div>
            <span class="text-xs text-muted"><%= r.label %></span>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Periodo</th>
            <th>Total</th>
            <th>Pagado</th>
            <th>Saldo</th>
            <th>Cumplimiento</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% for (const r of reportItems) { %>
            <% const saldo = r.total - r.paid; %>
            <% const pct = r.total === 0 ? 0 : Math.round((r.paid / r.total) * 100); %>
            <tr>
              <td><%= r.label %></td>
              <td>$ <%= Math.round(r.total / 1000) %>k</td>
              <td>$ <%= Math.round(r.paid / 1000) %>k</td>
              <td>$ <%= Math.round(saldo / 1000) %>k</td>
              <td><%= pct %>%</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
