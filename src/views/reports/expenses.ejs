<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Gastos por categoria', actions: [{ label: 'Exportar', href: '#', class: 'btn-secondary' }] }) %>

  <div class="card">
    <ul class="space-y-3">
      <% for (const c of [
        { label: 'Mantenciones', percent: 35 },
        { label: 'Personal', percent: 25 },
        { label: 'Servicios basicos', percent: 20 },
        { label: 'Seguros', percent: 10 },
        { label: 'Administracion', percent: 7 },
        { label: 'Otros', percent: 3 }
      ]) { %>
        <li>
          <div class="flex justify-between text-sm mb-1">
            <span class="font-medium"><%= c.label %></span>
            <span class="text-muted"><%= c.percent %>%</span>
          </div>
          <div class="h-2 bg-ivory rounded-full overflow-hidden">
            <div class="h-full bg-gold-pattern" style="width: <%= c.percent %>%"></div>
          </div>
        </li>
      <% } %>
    </ul>
  </div>
</div>