<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Detalle de morosidad', actions: [{ label: 'Exportar CSV', href: '/app/reportes/morosidad/csv', class: 'btn-secondary' }] }) %>

  <% const reportItems = locals.items || []; %>
  <% if (reportItems.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin morosidad', description: 'No hay torres con deuda para el alcance actual.' }) %>
  <% } else { %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% for (const t of reportItems) { %>
        <div class="card">
          <h3 class="font-display text-lg text-navy-900"><%= t.label %></h3>
          <p class="text-sm text-muted mt-2">Facturado: $ <%= Math.round(t.total / 1000) %>k</p>
          <p class="text-sm text-muted">Pagado: $ <%= Math.round(t.paid / 1000) %>k</p>
          <p class="text-sm text-muted">Saldo: $ <%= Math.round(t.balance / 1000) %>k</p>
          <p class="text-xs text-muted mt-1"><%= t.percent %>% en mora</p>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
