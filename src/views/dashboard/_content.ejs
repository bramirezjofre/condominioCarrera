<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
  <% const stats = typeof dashboardStats !== 'undefined' ? dashboardStats : []; %>
  <% for (const s of stats) { %>
    <article class="stat-card">
      <p class="stat-card-label"><%= s.label %></p>
      <p class="stat-card-value"><%= s.value %></p>
      <% if (s.help) { %>
        <p class="stat-card-help"><%= s.help %></p>
      <% } %>
    </article>
  <% } %>
</div>

<section class="grid gap-6 lg:grid-cols-3 mt-8">
  <div class="card lg:col-span-2">
    <header class="flex items-center justify-between mb-4">
      <div>
        <h2 class="font-display text-xl text-navy-900">Recaudacion</h2>
        <p class="text-sm text-muted">Comparativo de los ultimos 6 meses</p>
      </div>
      <span class="badge-navy">Mensual</span>
    </header>
    <div class="h-56 flex items-end gap-3" role="img" aria-label="Grafico de recaudacion mensual">
      <% const chart = typeof collectionChart !== 'undefined' ? collectionChart : []; %>
      <% const maxValue = chart.reduce((m, c) => Math.max(m, c.value), 0); %>
      <% for (const c of chart) { %>
        <% const height = maxValue === 0 ? 0 : Math.max(4, Math.round((c.value / maxValue) * 100)); %>
        <div class="flex-1 flex flex-col items-center gap-1">
          <span class="text-xs text-muted">$ <%= Math.round(c.value / 1000) %>k</span>
          <div class="w-full bg-gold-pattern rounded-t-md" style="height: <%= height %>%"></div>
          <span class="text-xs text-muted mt-1"><%= c.label %></span>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2 class="font-display text-xl text-navy-900 mb-4">Resumen del condominio</h2>
    <dl class="space-y-3 text-sm">
      <div class="flex justify-between">
        <dt class="text-muted">Torres</dt>
        <dd class="font-semibold"><%= towersCount %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-muted">Unidades</dt>
        <dd class="font-semibold"><%= unitsCount %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-muted">Residentes</dt>
        <dd class="font-semibold"><%= residentsCount %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-muted">Pagos del mes</dt>
        <dd class="font-semibold"><%= paymentsCount %></dd>
      </div>
    </dl>
  </div>
</section>

<section class="grid gap-6 lg:grid-cols-2 mt-8">
  <div class="card">
    <header class="flex items-center justify-between mb-4">
      <h2 class="font-display text-xl text-navy-900">Morosidad por torre</h2>
      <a href="/app/morosidad" class="text-sm text-navy-900 hover:underline">Ver detalle</a>
    </header>
    <ul class="space-y-3">
      <% for (const t of delinquencyByTower) { %>
        <li>
          <div class="flex justify-between text-sm mb-1">
            <span class="font-medium"><%= t.name %></span>
            <span class="text-muted"><%= t.units %> unidades</span>
          </div>
          <div class="h-2 bg-ivory rounded-full overflow-hidden">
            <div class="h-full bg-warning" style="width: <%= t.percent %>%"></div>
          </div>
          <p class="text-xs text-muted mt-1"><%= t.percent %>% en mora</p>
        </li>
      <% } %>
    </ul>
  </div>

  <div class="card">
    <header class="flex items-center justify-between mb-4">
      <h2 class="font-display text-xl text-navy-900">Actividad reciente</h2>
      <a href="/app/auditoria" class="text-sm text-navy-900 hover:underline">Auditoria</a>
    </header>
    <ul class="space-y-3 text-sm">
      <% for (const a of recentActivity) { %>
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 rounded-full bg-gold-500 mt-2" aria-hidden="true"></span>
          <div>
            <p class="font-medium"><%= a.title %></p>
            <p class="text-xs text-muted"><%= a.detail %></p>
          </div>
        </li>
      <% } %>
    </ul>
  </div>
</section>