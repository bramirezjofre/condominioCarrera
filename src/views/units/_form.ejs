<div class="card max-w-xl">
  <h2 class="text-lg font-semibold text-navy-900 mb-4"><%= title %></h2>
  <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-3 py-2 rounded mb-4 text-sm">
      <%= error %>
    </div>
  <% } %>
  <form method="post" action="<%= values.id ? '/app/unidades/' + values.id : '/app/torres/' + tower.id + '/unidades' %>" class="space-y-4">
    <div>
      <label for="number" class="block text-sm font-medium mb-1">Numero</label>
      <input id="number" name="number" required value="<%= values.number ?? '' %>"
        class="w-full border border-border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500" />
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="floor" class="block text-sm font-medium mb-1">Piso</label>
        <input id="floor" name="floor" type="number" min="0" value="<%= values.floor ?? '' %>"
          class="w-full border border-border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500" />
      </div>
      <div>
        <label for="kind" class="block text-sm font-medium mb-1">Tipo</label>
        <select id="kind" name="kind" class="w-full border border-border rounded px-3 py-2">
          <% for (const k of ['departamento','local','bodega','estacionamiento','otro']) { %>
            <option value="<%= k %>" <%= values.kind === k ? 'selected' : '' %>><%= k %></option>
          <% } %>
        </select>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="prorationFactor" class="block text-sm font-medium mb-1">Prorrateo</label>
        <input id="prorationFactor" name="prorationFactor" type="number" step="0.000001" min="0" max="1" value="<%= values.proration_factor ?? values.prorationFactor ?? 0 %>"
          class="w-full border border-border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500" />
      </div>
      <div>
        <label for="areaM2" class="block text-sm font-medium mb-1">Area m2</label>
        <input id="areaM2" name="areaM2" type="number" step="0.01" min="0" value="<%= values.area_m2 ?? values.areaM2 ?? '' %>"
          class="w-full border border-border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500" />
      </div>
    </div>
    <% if (values.id) { %>
      <div class="flex items-center gap-2">
        <input id="active" name="active" type="checkbox" <%= values.active ? 'checked' : '' %> />
        <label for="active" class="text-sm">Activa</label>
      </div>
    <% } %>
    <div class="flex gap-2">
      <button type="submit" class="btn-primary">Guardar</button>
      <a href="/app/torres/<%= tower.id %>" class="btn bg-gray-100 hover:bg-gray-200 text-navy-900">Cancelar</a>
    </div>
  </form>
</div>