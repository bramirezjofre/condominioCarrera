<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Datos de la unidad', actions: [{ label: 'Volver', href: '/app/torres/' + (tower ? tower.id : ''), class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="<%= formAction %>" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="number" class="label">Numero</label>
          <input id="number" name="number" class="input" value="<%= item.number %>" <%= errors.number ? 'aria-invalid="true"' : '' %> required />
          <% if (errors.number) { %><p class="text-xs text-danger mt-1"><%= errors.number %></p><% } %>
        </div>
        <div>
          <label for="floor" class="label">Piso</label>
          <input id="floor" name="floor" type="number" class="input" value="<%= item.floor ?? '' %>" />
        </div>
        <div>
          <label for="kind" class="label">Tipo</label>
          <select id="kind" name="kind" class="select">
            <% for (const k of ['departamento','local','bodega','estacionamiento','otro']) { %>
              <option value="<%= k %>" <%= item.kind === k ? 'selected' : '' %>><%= k %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="prorationFactor" class="label">Prorrateo</label>
          <input id="prorationFactor" name="prorationFactor" type="number" step="0.000001" class="input" value="<%= item.prorationFactor %>" <%= errors.prorationFactor ? 'aria-invalid="true"' : '' %> />
          <% if (errors.prorationFactor) { %><p class="text-xs text-danger mt-1"><%= errors.prorationFactor %></p><% } %>
        </div>
        <div>
          <label for="areaM2" class="label">Area m2</label>
          <input id="areaM2" name="areaM2" type="number" step="0.01" class="input" value="<%= item.areaM2 ?? '' %>" />
        </div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary" aria-label="Guardar unidad">Guardar</button>
        <a href="<%= cancelHref %>" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>