<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Detalle de encomienda', actions: [{ label: 'Volver', href: '/app/encomiendas', class: 'btn-secondary' }] }) %>

  <section class="card grid gap-4 md:grid-cols-2">
    <div><dt class="text-muted">Tracking</dt><dd class="font-medium"><%= item.trackingNumber %></dd></div>
    <div><dt class="text-muted">Transportista</dt><dd class="font-medium"><%= item.carrier %></dd></div>
    <div><dt class="text-muted">Unidad</dt><dd class="font-medium"><%= unit ? unit.number : '-' %></dd></div>
    <div><dt class="text-muted">Destinatario</dt><dd class="font-medium"><%= recipient ? recipient.fullName : '-' %></dd></div>
    <div><dt class="text-muted">Descripcion</dt><dd class="font-medium"><%= item.description %></dd></div>
    <div><dt class="text-muted">Estado</dt><dd class="font-medium"><%= item.status %></dd></div>
    <div><dt class="text-muted">Recibida</dt><dd class="font-medium"><%= item.receivedAt %></dd></div>
    <div><dt class="text-muted">Entregada</dt><dd class="font-medium"><%= item.deliveredAt || '-' %></dd></div>
  </section>

  <% if (canManage) { %>
    <div class="card">
      <h2 class="font-display text-xl text-navy-900 mb-4">Acciones</h2>
      <div class="flex flex-wrap gap-2">
        <% if (item.status === 'received') { %>
          <form method="post" action="/app/encomiendas/<%= item.id %>/notificar" class="inline">
            <button type="submit" class="btn-primary" aria-label="Notificar encomienda">Notificar</button>
          </form>
        <% } %>
        <% if (item.status === 'notified' || item.status === 'received') { %>
          <form method="post" action="/app/encomiendas/<%= item.id %>/entregar" class="inline">
            <button type="submit" class="btn-secondary" aria-label="Marcar entregada">Marcar entregada</button>
          </form>
        <% } %>
        <% if (item.status !== 'delivered') { %>
          <form method="post" action="/app/encomiendas/<%= item.id %>/devolver" class="inline">
            <label class="flex items-center gap-2">
              <input type="text" name="reason" placeholder="Motivo obligatorio" class="input" required />
            </label>
            <button type="submit" class="btn-danger" aria-label="Devolver encomienda">Devolver</button>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
