<%
  const groups = (typeof navGroups !== 'undefined' && navGroups) || [];
  const active = (typeof path !== 'undefined' && path) || (typeof ACTIVEPATH !== 'undefined' && ACTIVEPATH) || '';
  const userData = (typeof user !== 'undefined' && user) || (typeof locals !== 'undefined' && locals.user) || {};
%>
<aside class="hidden lg:flex lg:flex-col w-72 bg-navy-900 text-white shrink-0" aria-label="Navegacion principal">
  <div class="px-6 py-6 border-b border-navy-800">
    <div class="flex items-center gap-3">
      <%- include('logo', { size: 'h-12 w-auto' }) %>
      <div>
        <p class="font-display text-lg leading-tight">JMC</p>
        <p class="text-xs text-white/60">Administracion</p>
      </div>
    </div>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-6" aria-label="Modulos">
    <% for (const group of groups) { %>
      <div>
        <p class="px-3 text-[10px] uppercase tracking-wider text-white/40 mb-2"><%= group.label %></p>
        <ul class="space-y-1">
          <% for (const item of group.items) { %>
            <% const isActive = active === item.href || (item.href !== '/app' && active.startsWith(item.href + '/')); %>
            <li>
              <a
                href="<%= item.href %>"
                class="<%= isActive ? 'nav-link nav-link-active' : 'nav-link' %>"
                aria-current="<%= isActive ? 'page' : 'false' %>"
              >
                <span class="w-5 h-5 inline-flex items-center justify-center text-white/70" aria-hidden="true">
                  <%- include('../icons/' + item.icon) %>
                </span>
                <span><%= item.label %></span>
              </a>
            </li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </nav>

  <div class="px-4 py-4 border-t border-navy-800">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-9 h-9 rounded-full bg-gold-600 text-white flex items-center justify-center font-semibold">
        <%= (userData.fullName || 'U').charAt(0).toUpperCase() %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate"><%= userData.fullName || 'Usuario' %></p>
        <p class="text-xs text-white/60 truncate"><%= userData.isCondominiumAdmin ? 'Administrador general' : (userData.roleCodes?.join(', ') || 'Usuario') %></p>
      </div>
    </div>
    <form method="post" action="/logout">
      <button type="submit" class="btn btn-secondary btn-sm w-full">
        Cerrar sesion
      </button>
    </form>
  </div>
</aside>