<%
  const headerTitle = typeof titleText !== 'undefined' ? titleText : (typeof title !== 'undefined' ? title : '');
  const headerSubtitle = typeof subtitleText !== 'undefined' ? subtitleText : '';
  const headerActions = typeof actions !== 'undefined' ? actions : [];
%>
<header class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between mb-6">
  <div>
    <h1 class="font-display text-2xl md:text-3xl text-navy-900"><%= headerTitle %></h1>
    <% if (headerSubtitle) { %>
      <p class="text-sm text-muted mt-1"><%= headerSubtitle %></p>
    <% } %>
  </div>
  <% if (headerActions.length > 0) { %>
    <div class="flex flex-wrap gap-2">
      <% for (const a of headerActions) { %>
        <a href="<%= a.href %>" class="<%= a.class || 'btn-secondary' %>">
          <%= a.label %>
        </a>
      <% } %>
    </div>
  <% } %>
</header>