<div class="card text-center py-10">
  <div class="mx-auto w-12 h-12 rounded-full bg-ivory flex items-center justify-center text-muted mb-4" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
  </div>
  <h3 class="font-display text-lg text-navy-900 mb-1"><%= title %></h3>
  <% if (typeof description !== 'undefined' && description) { %>
    <p class="text-sm text-muted mb-4"><%= description %></p>
  <% } %>
  <% if (typeof action !== 'undefined' && action) { %>
    <a href="<%= action.href %>" class="btn-primary">
      <%= action.label %>
    </a>
  <% } %>
</div>