<form method="get" action="<%= action %>" class="card-tight">
  <div class="flex flex-col gap-2 md:flex-row md:items-center">
    <% if (typeof search !== 'undefined' && search) { %>
      <div class="flex-1">
        <label for="searchInput" class="visually-hidden">Buscar</label>
        <input type="search" id="searchInput" name="search" value="<%= search %>" placeholder="<%= searchPlaceholder || 'Buscar...' %>" class="input" />
      </div>
    <% } %>
    <% for (const f of filters) { %>
      <div>
        <label for="filter<%= f.name %>" class="visually-hidden"><%= f.label %></label>
        <select id="filter<%= f.name %>" name="<%= f.name %>" class="select" onchange="this.form.submit()">
          <option value=""><%= f.label %></option>
          <% for (const opt of f.options) { %>
            <option value="<%= opt.value %>" <%= opt.value === current[f.name] ? 'selected' : '' %>><%= opt.label %></option>
          <% } %>
        </select>
      </div>
    <% } %>
    <button type="submit" class="btn-primary btn-sm">Filtrar</button>
  </div>
</form>