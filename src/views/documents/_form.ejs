<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Subida de documento', actions: [{ label: 'Volver', href: '/app/documentos', class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="<%= formAction %>" class="space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="title" class="label">Titulo</label>
          <input id="title" name="title" class="input" value="<%= item.title || '' %>" <%= errors.title ? 'aria-invalid="true"' : '' %> required />
          <% if (errors.title) { %><p class="text-xs text-danger mt-1"><%= errors.title %></p><% } %>
        </div>
        <div>
          <label for="categoryId" class="label">Categoria</label>
          <select id="categoryId" name="categoryId" class="select">
            <% for (const c of ['reglamento','actas','financieros','contratos','manuales']) { %>
              <option value="<%= c %>"><%= c %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="visibility" class="label">Visibilidad</label>
          <select id="visibility" name="visibility" class="select">
            <% for (const v of ['administration','committee','residents','public']) { %>
              <option value="<%= v %>" <%= item.visibility === v ? 'selected' : '' %>><%= v %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="expiresAt" class="label">Vencimiento</label>
          <input id="expiresAt" name="expiresAt" type="date" class="input" />
        </div>
        <div class="md:col-span-2">
          <label for="description" class="label">Descripcion</label>
          <textarea id="description" name="description" class="textarea"><%= item.description || '' %></textarea>
        </div>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary" aria-label="Guardar documento">Guardar</button>
        <a href="<%= cancelHref %>" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>