<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Periodos mensuales de gastos comunes', actions: [{ label: 'Nuevo periodo', href: '/app/gastos-comunes/nuevo', class: 'btn-primary' }] }) %>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin periodos', description: 'Crea el primer periodo mensual.' }) %>
  <% } else { %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% for (const p of items) { %>
        <a href="/app/gastos-comunes/<%= p.id %>" class="card-tight hover:border-gold-500 transition block">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-lg text-navy-900"><%= p.monthName %> <%= p.year %></h3>
            <% if (p.status === 'draft') { %>
              <span class="badge-warning">Borrador</span>
            <% } else if (p.status === 'issued') { %>
              <span class="badge-info">Emitido</span>
            <% } else if (p.status === 'closed') { %>
              <span class="badge-success">Cerrado</span>
            <% } else { %>
              <span class="badge-muted">Anulado</span>
            <% } %>
          </div>
          <p class="text-sm text-muted">Vence: <%= p.dueDate %></p>
          <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <div><dt class="text-muted">Total</dt><dd class="font-semibold">$ <%= Math.round(p.total / 1000) %>k</dd></div>
            <div><dt class="text-muted">Pagado</dt><dd class="font-semibold"><%= p.percent %>%</dd></div>
          </div>
        </a>
      <% } %>
    </div>
  <% } %>
</div>