<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: period.monthName + ' ' + period.year, subtitleText: 'Resumen del periodo', actions: [
    { label: 'Editar', href: '/app/gastos-comunes/' + period.id + '/editar', class: 'btn-secondary' },
    { label: 'Gastos', href: '/app/gastos-comunes/' + period.id + '/gastos', class: 'btn-primary' },
    { label: 'Cargos', href: '/app/gastos-comunes/' + period.id + '/cargos', class: 'btn-gold' }
  ] }) %>

  <section class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <%- include('../partials/stat-card', { label: 'Estado', value: period.status }) %>
    <%- include('../partials/stat-card', { label: 'Total', value: '$ ' + Math.round(period.totalAmount / 1000) + 'k' }) %>
    <%- include('../partials/stat-card', { label: 'Vence', value: period.dueDate }) %>
    <%- include('../partials/stat-card', { label: 'Notas', value: period.notes || '-' }) %>
  </section>

  <section class="card">
    <h2 class="font-display text-xl text-navy-900 mb-4">Cargos</h2>
    <% if (charges.length === 0) { %>
      <%- include('../partials/empty-state', { title: 'Sin cargos', description: 'Emite el periodo para generar cargos.' }) %>
    <% } else { %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Unidad</th>
              <th>Torre</th>
              <th>Total</th>
              <th>Pagado</th>
              <th>Saldo</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% for (const c of charges) { %>
              <tr>
                <td><%= c.unit ? c.unit.number : '-' %></td>
                <td><%= c.tower ? c.tower.name : '-' %></td>
                <td>$ <%= Math.round(c.totalAmount / 1000) %>k</td>
                <td>$ <%= Math.round(c.paidAmount / 1000) %>k</td>
                <td>$ <%= Math.round(c.balanceAmount / 1000) %>k</td>
                <td>
                  <% if (c.status === 'paid') { %>
                    <span class="badge-success">Pagado</span>
                  <% } else if (c.status === 'overdue') { %>
                    <span class="badge-danger">Vencido</span>
                  <% } else { %>
                    <span class="badge-warning">Pendiente</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>