<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Unidades con saldo pendiente por torre', actions: [{ label: 'Volver', href: '/app/morosidad', class: 'btn-secondary' }] }) %>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin deudas', description: 'Todas las unidades estan al dia.' }) %>
  <% } else { %>
    <% for (const group of items) { %>
      <section class="card">
        <h2 class="font-display text-xl text-navy-900 mb-4"><%= group.tower.name %></h2>
        <% if (group.units.length === 0) { %>
          <p class="text-sm text-muted">Sin deudas.</p>
        <% } else { %>
          <div class="table-container">
            <table class="table">
              <thead>
                <tr>
                  <th>Unidad</th>
                  <th>Piso</th>
                  <th>Ocupante</th>
                  <th>Saldo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <% for (const u of group.units) { %>
                  <tr>
                    <td><a class="text-navy-900 hover:underline" href="/app/unidades/<%= u.unit.id %>"><%= u.unit.number %></a></td>
                    <td><%= u.unit.floor ?? '-' %></td>
                    <td><%= u.person ? u.person.fullName : 'Sin ocupante' %></td>
                    <td><span class="badge-warning">$ <%= Math.round(u.balance / 1000) %>k</span></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>
  <% } %>
</div>