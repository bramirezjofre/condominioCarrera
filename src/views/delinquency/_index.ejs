<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Resumen por torre', actions: [
    { label: 'Por torre', href: '/app/morosidad/torres', class: 'btn-secondary' },
    { label: 'Por unidad', href: '/app/morosidad/unidades', class: 'btn-gold' }
  ] }) %>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin morosidad', description: 'No hay unidades con saldo pendiente.' }) %>
  <% } else { %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% for (const t of items) { %>
        <div class="card">
          <h3 class="font-display text-lg text-navy-900"><%= t.tower.name %></h3>
          <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
            <div><dt class="text-muted">Total</dt><dd class="font-semibold">$ <%= Math.round(t.total / 1000) %>k</dd></div>
            <div><dt class="text-muted">Pagado</dt><dd class="font-semibold">$ <%= Math.round(t.paid / 1000) %>k</dd></div>
            <div><dt class="text-muted">Saldo</dt><dd class="font-semibold">$ <%= Math.round(t.balance / 1000) %>k</dd></div>
            <div><dt class="text-muted">%</dt><dd class="font-semibold"><%= t.percent %>%</dd></div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>