<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Asignar responsable', actions: [{ label: 'Volver', href: '/app/mantenimientos/' + item.id, class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="<%= formAction %>" class="space-y-4">
      <div>
        <label for="userId" class="label">Responsable</label>
        <select id="userId" name="userId" class="select" required>
          <option value="">Seleccionar...</option>
          <% for (const u of users) { %>
            <option value="<%= u.id %>"><%= u.username %></option>
          <% } %>
        </select>
        <% if (errors.userId) { %><p class="text-xs text-danger mt-1"><%= errors.userId %></p><% } %>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary" aria-label="Asignar responsable">Asignar</button>
        <a href="<%= cancelHref %>" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>