<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Asignar ocupante a la unidad', actions: [{ label: 'Volver', href: '/app/unidades/' + unit.id + '/ocupaciones', class: 'btn-secondary' }] }) %>

  <div class="card">
    <form method="post" action="<%= formAction %>" class="space-y-4">
      <div>
        <label for="personId" class="label">Persona</label>
        <select id="personId" name="personId" class="select" required>
          <option value="">Seleccionar...</option>
          <% for (const p of people) { %>
            <option value="<%= p.id %>"><%= p.fullName %></option>
          <% } %>
        </select>
        <% if (errors.personId) { %><p class="text-xs text-danger mt-1"><%= errors.personId %></p><% } %>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <label for="occupancyType" class="label">Tipo</label>
          <select id="occupancyType" name="occupancyType" class="select">
            <% for (const k of ['owner','tenant','resident','authorized']) { %>
              <option value="<%= k %>" <%= item.occupancyType === k ? 'selected' : '' %>><%= k %></option>
            <% } %>
          </select>
        </div>
        <div>
          <label for="startsOn" class="label">Desde</label>
          <input id="startsOn" name="startsOn" type="date" class="input" value="<%= item.startsOn %>" <%= errors.startsOn ? 'aria-invalid="true"' : '' %> required />
          <% if (errors.startsOn) { %><p class="text-xs text-danger mt-1"><%= errors.startsOn %></p><% } %>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="isPrimary" <%= item.isPrimary ? 'checked' : '' %> /> Principal
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="receivesBilling" checked /> Recibe cobranza
        </label>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="receivesNotifications" checked /> Recibe avisos
        </label>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="btn-primary" aria-label="Guardar ocupacion">Guardar</button>
        <a href="<%= cancelHref %>" class="btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>