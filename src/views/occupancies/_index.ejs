<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Ocupantes de la unidad', actions: [{ label: 'Nueva ocupacion', href: '/app/unidades/' + unit.id + '/ocupaciones/nuevo', class: 'btn-primary' }] }) %>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', { title: 'Sin ocupaciones', description: 'Agrega un ocupante principal para esta unidad.' }) %>
  <% } else { %>
    <div class="card table-container">
      <table class="table">
        <thead>
          <tr>
            <th>Persona</th>
            <th>Tipo</th>
            <th>Principal</th>
            <th>Desde</th>
            <th>Hasta</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% for (const o of items) { %>
            <tr>
              <td><%= o.person ? o.person.fullName : 'Sin persona' %></td>
              <td><%= o.occupancyType %></td>
              <td><span class="<%= o.isPrimary ? 'badge-gold' : 'badge-muted' %>"><%= o.isPrimary ? 'Principal' : 'Secundaria' %></span></td>
              <td><%= o.startsOn %></td>
              <td><%= o.endsOn || 'Vigente' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>