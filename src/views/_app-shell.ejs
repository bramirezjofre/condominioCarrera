<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#09264d" />
  <title><%= title %> | Condominio Jose Miguel Carrera</title>
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/img/logo-jmc.jpg" type="image/jpeg" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="bg-ivory text-text font-sans">
  <a href="#mainContent" class="skip-link">Saltar al contenido</a>
  <div class="flex min-h-screen">
    <%- include('partials/sidebar') %>
    <div class="flex-1 flex flex-col min-w-0">
      <%- include('partials/mobile-header') %>
      <main id="mainContent" class="flex-1 px-4 md:px-8 py-6 bg-ivory">
        <div class="mx-auto max-w-7xl">
          <%- include('partials/demo-banner') %>
          <% if (typeof crumbs !== 'undefined' && crumbs && crumbs && crumbs.length > 1) { %>
            <%- include('partials/breadcrumbs') %>
          <% } %>
          <%- include(partialPath) %>
        </div>
      </main>
      <%- include('partials/mobile-nav') %>
    </div>
  </div>
  <script src="/js/app.js" defer></script>
</body>
</html>