<div class="space-y-6">
  <%- include('../partials/page-header', { titleText: title, subtitleText: 'Datos de la multa', actions: [{ label: 'Volver', href: '/app/multas', class: 'btn-secondary' }] }) %>

  <section class="card grid gap-4 md:grid-cols-2">
    <div><dt class="text-muted">Motivo</dt><dd class="font-medium"><%= item.reason %></dd></div>
    <div><dt class="text-muted">Codigo</dt><dd class="font-medium"><%= item.ruleCode %></dd></div>
    <div><dt class="text-muted">Unidad</dt><dd class="font-medium"><%= unit ? unit.number : '-' %></dd></div>
    <div><dt class="text-muted">Persona</dt><dd class="font-medium"><%= person ? person.fullName : '-' %></dd></div>
    <div><dt class="text-muted">Incidente</dt><dd class="font-medium"><%= item.incidentAt %></dd></div>
    <div><dt class="text-muted">Monto</dt><dd class="font-medium">$ <%= Math.round(item.amount / 1000) %>k</dd></div>
    <div><dt class="text-muted">Estado</dt><dd class="font-medium"><%= item.status %></dd></div>
    <div><dt class="text-muted">Notificada</dt><dd class="font-medium"><%= item.notifiedAt || '-' %></dd></div>
  </section>

  <div class="card">
    <h2 class="font-display text-xl text-navy-900 mb-4">Acciones</h2>
    <div class="flex flex-wrap gap-2">
      <% if (canVerify) { %>
        <form method="post" action="/app/multas/<%= item.id %>/notificar" class="inline">
          <button type="submit" class="btn-primary" aria-label="Notificar multa">Notificar</button>
        </form>
        <form method="post" action="/app/multas/<%= item.id %>/confirmar" class="inline">
          <button type="submit" class="btn-secondary" aria-label="Confirmar multa">Confirmar</button>
        </form>
        <form method="post" action="/app/multas/<%= item.id %>/anular" class="inline">
          <label class="flex items-center gap-2">
            <input type="text" name="reason" placeholder="Motivo obligatorio" class="input" required />
          </label>
          <button type="submit" class="btn-danger" aria-label="Anular multa">Anular</button>
        </form>
      <% } %>
      <% if (canAppeal) { %>
        <form method="post" action="/app/multas/<%= item.id %>/apelar" class="inline">
          <label class="flex items-center gap-2">
            <input type="text" name="reason" placeholder="Motivo de apelacion" class="input" required />
          </label>
          <button type="submit" class="btn-ghost" aria-label="Registrar apelacion">Registrar apelacion</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
