NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TZ=America/Santiago

# Supabase Session Pooler (IPv4) - copiar desde Dashboard -> Connect -> Session pooler
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MAX=10

SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
SUPABASE_STORAGE_BUCKET=condominio-documentos

SESSION_SECRET=replace_me_with_64_chars_random
SESSION_COOKIE_NAME=condominio.sid

SEED_ADMIN_EMAIL=admin@condominio.cl
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULL_NAME=Administrador General
SEED_ADMIN_PASSWORD=CambiarEsto123!

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dominio.cl